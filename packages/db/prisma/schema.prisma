generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ Auth & Users ============

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  emailVerified        DateTime?
  name                 String?
  image                String?
  passwordHash         String?
  role                 String    @default("viewer") // admin, editor, viewer
  receiveNotifications Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  posts    Post[]
  sessions Session[]
  accounts Account[]
  bookLikes BookLike[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Content ============

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  coverImage  String?
  status      String    @default("draft") // draft, published
  views       Int       @default(0)
  authorId    String
  categoryId  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User      @relation(fields: [authorId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  tags     PostTag[]
  comments Comment[]

  @@index([status, publishedAt])
  @@index([views])
}

model Category {
  id      String  @id @default(cuid())
  name    String  @unique
  name_en String?
  slug    String  @unique

  posts Post[]
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  authorName  String
  authorEmail String?
  authorUrl   String?
  locale      String?  @default("zh")
  status      String   @default("pending") // pending, approved, spam
  postId      String
  parentId    String?
  createdAt   DateTime @default(now())

  post   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([postId, status])
}

// ============ Portfolio ============

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description   String
  descriptionEn String?
  coverImage    String?
  liveUrl     String?
  repoUrl     String?
  techStack   String[] @default([])
  sortOrder   Int      @default(0)
  featured         Boolean  @default(false)
  privacyPolicy    String?
  privacyPolicyEn  String?
  termsOfService   String?
  termsOfServiceEn String?
  logo             String?
  downloadLinks    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============ Media ============

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  type      String   // image, video, document
  size      Int
  width     Int?
  height    Int?
  alt       String?
  createdAt DateTime @default(now())
}

// ============ Guestbook ============

model GuestbookEntry {
  id         String   @id @default(cuid())
  content    String
  authorName String
  avatar     String?
  createdAt  DateTime @default(now())
}

// ============ Links ============

model Link {
  id          String   @id @default(cuid())
  name        String
  url         String
  rss         String?
  avatar      String?
  screenshot  String?
  description String?
  category    String   @default("default")
  status      String   @default("approved")
  isAlive     Boolean  @default(true)
  sortOrder   Int      @default(0)
  submitterIp String?
  email       String?
  locale      String?  @default("zh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([submitterIp, createdAt])
  @@index([status])
}

// ============ Analytics ============

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  country   String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

// ============ Site Config ============

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@index([key])
}

// ============ About Info ============

model AboutInfo {
  id             String   @id @default("default")
  title          String   @default("The Developer")
  title_en       String?
  subtitle       String   @default("ABOUT ME")
  subtitle_en    String?
  description    String   @db.Text
  description_en String?  @db.Text
  experiences    Json     @default("[]")
  socialLinks    Json     @default("[]")
  email          Json?
  author         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============ References ============

model Reference {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  htmlCode  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ Attachments ============

model Attachment {
  id        String   @id @default(cuid())
  filename  String   @unique
  mimeType  String
  url       String   @default("") // S3/R2 Public URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ Books ============

model Book {
  id                 String     @id @default(cuid())
  slug               String     @unique
  title              String
  coverImageURL      String?
  author             String
  publisher          String?
  translator         String?
  isbn               String?
  publishYear        String?
  ebookUrl           String?
  description        String?  @db.Text
  review             String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  likes              BookLike[]

  originalBookId     String?
  originalBook       Book?      @relation("BookTranslations", fields: [originalBookId], references: [id])
  translations       Book[]     @relation("BookTranslations")
}

// ============ Book Likes & Dislikes ============

model BookLike {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  type      String   // "LIKE" or "DISLIKE"
  createdAt DateTime @default(now())

  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([bookId])
  @@index([userId])
}

// ============ AI Trending ============

model TrendingRepo {
  id             String   @id @default(cuid())
  githubId       Int                       // GitHub repo numeric ID
  name           String                    // e.g. "codex"
  fullName       String                    // e.g. "openai/codex"
  url            String                    // GitHub URL
  description    String?                   // GitHub original description
  language       String?                   // Primary language
  stars          Int                       // Star count at fetch time
  forks          Int      @default(0)
  starsGrowth    Int      @default(0)       // Stars gained this week (calculated delta)
  repoCreatedAt  DateTime                  // When the repo was created on GitHub
  topics         String[] @default([])     // GitHub topics array

  // AI-generated bilingual summaries (filled manually via Admin)
  summaryZh      String?  @db.Text         // 中文摘要
  summaryEn      String?  @db.Text         // English summary

  // Metadata
  weekOf         DateTime                  // The Monday of the week this was fetched for
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([githubId, weekOf])
  @@index([weekOf])
  @@index([stars])
  @@index([starsGrowth])
}

model TrendingWeek {
  id        String   @id @default(cuid())
  weekOf    DateTime @unique
  createdAt DateTime @default(now())

  @@index([weekOf])
}

